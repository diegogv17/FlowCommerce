# URL de la API (con el prefijo /api/v1).
#   Local:      http://localhost:3000/api/v1
#   Producción: https://flowcommerce-8jwp.onrender.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Proyecto de Supabase (Settings → API). La anon/publishable key es pública:
# la protección real está en RLS y en la API, que verifica el token.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional: en desarrollo redirige /api hacia el backend local (evita CORS).
# Si lo usas, pon VITE_API_URL=/api/v1
# VITE_API_PROXY=http://localhost:3000
