# URL de la API de FlowCommerce (NestJS), con /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Supabase (Project Settings -> API). La "anon"/"publishable" key es pública.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de esta web (enlaces de correo de Supabase y metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Google Analytics 4 (opcional): G-XXXXXXX
NEXT_PUBLIC_GA_ID=
